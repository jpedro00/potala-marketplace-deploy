# Copie para .env e preencha com valores reais. Nunca versione .env.
# Booleanos aceitam apenas: true / false / 1 / 0. Números são inteiros inteiros.

# ---------------------------------------------------------------- aplicação
# development | test | production
NODE_ENV=development
# 1..65535. Cada serviço roda numa porta própria em local.
PORT=3001
# Origem pura do frontend: sem barra final, sem path. Comparada literalmente
# pelo OriginGuard.
FRONTEND_URL=http://localhost:3000

# -------------------------------------------------------------------- sessão
SESSION_COOKIE_NAME=potala_session
# Default: true quando NODE_ENV=production.
SESSION_COOKIE_SECURE=false
# 1..365
SESSION_TTL_DAYS=7

# ---------------------------------------------------------- docs e logging
# Default: true fora de produção.
SWAGGER_ENABLED=true
# Corpo da requisição sanitizado nos logs. Sempre forçado a false em produção.
LOG_HTTP_BODY=false

# ------------------------------------------------------------------ rate limit
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
# Aplica-se só às rotas /auth.
AUTH_THROTTLE_LIMIT=5
# Aplica-se só às rotas /internal (tráfego serviço-a-serviço; limite bem mais
# alto que o público).
INTERNAL_THROTTLE_LIMIT=600

# -------------------------------------------------------------------- banco
# Conexão de runtime usada pelo Prisma Client (pool do Supabase).
# O schema Postgres "identity" é criado pela própria migration deste serviço
# — não aponte para "public": este serviço não deve tocar tabelas de outro
# serviço.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Conexão direta usada só por prisma migrate / introspect.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ------------------------------------------------------------ admin seed
# Lido só por `npm run prisma:seed`. A API sobe sem essas variáveis.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_BEFORE_SEEDING
ADMIN_NAME=Administrador

# ----------------------------------------------------- integração interna
# Chave secreta compartilhada exigida no header `x-internal-api-key` em toda
# rota /internal/*. Gere com: openssl rand -hex 32
# Mínimo 16 caracteres. Cada serviço que chama /internal precisa conhecer
# esta mesma chave (ou uma própria, se você preferir uma por par de serviços).
INTERNAL_API_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# sellers-service ainda não existe. Preencha estas três variáveis quando ele
# subir — até lá, POST /auth/seller/register responde 503 de forma
# controlada (ver docs/internal-api-contract.md).
SELLERS_SERVICE_URL=
SELLERS_SERVICE_API_KEY=
SELLERS_SERVICE_TIMEOUT_MS=5000
