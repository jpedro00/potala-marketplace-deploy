# Copie para .env e preencha com valores reais. Nunca versione .env.
# Booleanos aceitam apenas: true / false / 1 / 0. Números são inteiros.

# ---------------------------------------------------------------- aplicação
# development | test | production
NODE_ENV=development
# 1..65535. Cada serviço roda numa porta própria em local (identity-service
# usa 3001, sellers-service usa 3002, api-gateway usa 8080; este serviço usa 3003).
PORT=3003
# Origem pura do frontend: sem barra final, sem path. Comparada literalmente
# pelo OriginGuard. Deve ser a mesma origem configurada nos outros serviços.
FRONTEND_URL=http://localhost:3000

# -------------------------------------------------------------------- sessão
# Precisa ser EXATAMENTE o mesmo nome de cookie configurado em
# identity-service (SESSION_COOKIE_NAME) — este serviço lê o mesmo cookie
# HttpOnly que identity-service emite no login, não emite o seu próprio.
SESSION_COOKIE_NAME=potala_session

# ---------------------------------------------------------- docs e logging
# Default: true fora de produção.
SWAGGER_ENABLED=true
# Corpo da requisição sanitizado nos logs. Sempre forçado a false em produção.
LOG_HTTP_BODY=false

# ------------------------------------------------------------------ rate limit
# Dois grupos agora (mesmo padrão de sellers-service): este serviço passou a
# expor suas próprias rotas /internal/* (consumidas por orders-service), que
# precisam de um limite mais alto que o público.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
INTERNAL_THROTTLE_LIMIT=600

# -------------------------------------------------------------------- banco
# Conexão de runtime usada pelo Prisma Client (pool do Supabase).
# O schema Postgres "catalog" é criado pela própria migration deste serviço
# — não aponte para "public": este serviço não deve tocar tabelas de outro
# serviço (identity, sellers, orders, ...).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Conexão direta usada só por prisma migrate / introspect.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ----------------------------------------------------- integração interna
# Este serviço não tem tabela de sessão local nem tabela de vínculo de
# vendedor local — ambas as dependências abaixo são obrigatórias, não
# opcionais.

# Chave própria deste serviço: protege as rotas /internal/* que ELE expõe
# (resolução de produto/variante e reserve/release/commit de estoque —
# consumidas por orders-service). Gere com: openssl rand -hex 32.
INTERNAL_API_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# identity-service: obrigatório para autenticar qualquer requisição (via
# POST /internal/sessions/introspect a cada request).
IDENTITY_SERVICE_URL=http://localhost:3001
# Deve ser a MESMA chave configurada como INTERNAL_API_KEY em identity-service.
IDENTITY_SERVICE_API_KEY=CHANGE_ME_SAME_SECRET_AS_IDENTITY_SERVICE_INTERNAL_API_KEY
IDENTITY_SERVICE_TIMEOUT_MS=5000

# sellers-service: obrigatório para resolver o contexto de vendedor
# (sellerId/papel/status) do usuário autenticado, em toda rota
# /seller/products/* (via GET /internal/sellers/membership/:userId).
SELLERS_SERVICE_URL=http://localhost:3002
# Deve ser a MESMA chave configurada como INTERNAL_API_KEY em sellers-service.
SELLERS_SERVICE_API_KEY=CHANGE_ME_SAME_SECRET_AS_SELLERS_SERVICE_INTERNAL_API_KEY
SELLERS_SERVICE_TIMEOUT_MS=5000
