# Copie para .env e preencha com valores reais. Nunca versione .env.
# Booleanos aceitam apenas: true / false / 1 / 0. Números são inteiros.

# ---------------------------------------------------------------- aplicação
# development | test | production
NODE_ENV=development
# 1..65535. Cada serviço roda numa porta própria em local (identity-service
# usa 3001; este serviço usa 3002).
PORT=3002
# Origem pura do frontend: sem barra final, sem path. Comparada literalmente
# pelo OriginGuard. Deve ser a mesma origem configurada em identity-service.
FRONTEND_URL=http://localhost:3000

# -------------------------------------------------------------------- sessão
# Precisa ser EXATAMENTE o mesmo nome de cookie configurado em
# identity-service (SESSION_COOKIE_NAME) — este serviço lê o mesmo cookie
# HttpOnly que identity-service emite no login, não emite o seu próprio.
SESSION_COOKIE_NAME=potala_session

# ---------------------------------------------------------- docs e logging
# Default: true fora de produção.
SWAGGER_ENABLED=true
# Corpo da requisição sanitizado nos logs. Sempre forçado a false em produção.
LOG_HTTP_BODY=false

# ------------------------------------------------------------------ rate limit
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
# Aplica-se só às rotas /internal (tráfego serviço-a-serviço; limite bem mais
# alto que o público).
INTERNAL_THROTTLE_LIMIT=600

# -------------------------------------------------------------------- banco
# Conexão de runtime usada pelo Prisma Client (pool do Supabase).
# O schema Postgres "sellers" é criado pela própria migration deste serviço
# — não aponte para "public": este serviço não deve tocar tabelas de outro
# serviço (identity, catalog, orders, ...).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Conexão direta usada só por prisma migrate / introspect.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ----------------------------------------------------- integração interna
# Chave secreta compartilhada exigida no header `x-internal-api-key` em toda
# rota /internal/* DESTE serviço (hoje: POST /internal/sellers, chamada por
# identity-service). Gere com: openssl rand -hex 32
INTERNAL_API_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# identity-service é dependência obrigatória: este serviço não tem tabela de
# sessão local e não autentica nenhuma requisição sem ele. Diferente de
# SELLERS_SERVICE_URL em identity-service (opcional), estas duas variáveis
# são obrigatórias.
IDENTITY_SERVICE_URL=http://localhost:3001
# Deve ser a MESMA chave configurada como INTERNAL_API_KEY em
# identity-service (ou uma própria, se você preferir uma chave por par de
# serviços — identity-service precisa reconhecer o valor enviado).
IDENTITY_SERVICE_API_KEY=CHANGE_ME_SAME_SECRET_AS_IDENTITY_SERVICE_INTERNAL_API_KEY
IDENTITY_SERVICE_TIMEOUT_MS=5000
