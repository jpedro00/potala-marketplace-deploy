# Copy to a private file outside Git. Supply credentials for HOMOLOGATION.
NODE_ENV=production
PORT=10000
FRONTEND_URL=https://REPLACE_ME.example
SESSION_COOKIE_NAME=potala_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=7
IDENTITY_DATABASE_URL=REPLACE_ME
IDENTITY_DIRECT_URL=REPLACE_ME
SELLERS_DATABASE_URL=REPLACE_ME
SELLERS_DIRECT_URL=REPLACE_ME
CATALOG_DATABASE_URL=REPLACE_ME
CATALOG_DIRECT_URL=REPLACE_ME
ORDERS_DATABASE_URL=REPLACE_ME
ORDERS_DIRECT_URL=REPLACE_ME
IDENTITY_INTERNAL_API_KEY=REPLACE_ME_AT_LEAST_32_RANDOM_CHARACTERS
SELLERS_INTERNAL_API_KEY=REPLACE_ME_AT_LEAST_32_RANDOM_CHARACTERS
CATALOG_INTERNAL_API_KEY=REPLACE_ME_AT_LEAST_32_RANDOM_CHARACTERS
# Internal URLs and each child PORT/HOST are assigned by the supervisor.
# ADMIN_* seed credentials are deliberately excluded from the server runtime.
# Optional per-service tuning: replace ORDERS with IDENTITY, SELLERS or CATALOG.
# ORDERS_THROTTLE_LIMIT=60
# ORDERS_THROTTLE_TTL_MS=60000
# ORDERS_IDENTITY_SERVICE_TIMEOUT_MS=5000
# ORDERS_SELLERS_SERVICE_TIMEOUT_MS=5000
# ORDERS_CATALOG_SERVICE_TIMEOUT_MS=5000
# IDENTITY_AUTH_THROTTLE_LIMIT=5
# IDENTITY_INTERNAL_THROTTLE_LIMIT=600
# SELLERS_INTERNAL_THROTTLE_LIMIT=600
# CATALOG_INTERNAL_THROTTLE_LIMIT=600
# ORDERS_PERMISSION_SHADOW_MODE=false
# GATEWAY_PROXY_TIMEOUT_MS=10000
# GATEWAY_HEALTH_CHECK_TIMEOUT_MS=3000
# GATEWAY_RATE_LIMIT_WINDOW_MS=60000
# GATEWAY_RATE_LIMIT_MAX=300
