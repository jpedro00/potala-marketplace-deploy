# Copie para .env e preencha com valores reais. Nunca versione .env.
# Números são inteiros.

# ---------------------------------------------------------------- aplicação
# development | test | production
NODE_ENV=development
# Porta própria do gateway — diferente de identity-service (3001),
# sellers-service (3002) e do frontend (3000).
PORT=8080
# Origem pura do frontend: sem barra final, sem path. Usada só para CORS
# aqui (enableCors) — a proteção real contra CSRF em requisições mutantes
# continua em cada serviço de origem (OriginGuard, inalterado), porque o
# gateway repassa o header Origin sem modificar.
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------- serviços de destino
# Obrigatórios os quatro — diferente de identity-service (onde
# SELLERS_SERVICE_URL é opcional), o gateway não tem função nenhuma sem os
# serviços configurados: seu único trabalho é rotear para eles.
IDENTITY_SERVICE_URL=http://localhost:3001
SELLERS_SERVICE_URL=http://localhost:3002
CATALOG_SERVICE_URL=http://localhost:3003
ORDERS_SERVICE_URL=http://localhost:3004
# Tempo máximo esperando uma resposta de qualquer serviço de destino antes
# de devolver 503 ao cliente.
PROXY_TIMEOUT_MS=10000
# Tempo máximo esperando cada serviço responder GET /health/ready ao montar
# GET /health/ready deste gateway (mais curto de propósito — uma checagem de
# prontidão deve falhar rápido).
HEALTH_CHECK_TIMEOUT_MS=3000

# ------------------------------------------------------------------ rate limit
# Limite global e grosso, por IP, na borda — proteção do próprio gateway (e,
# por tabela, de todos os serviços atrás dele) contra um cliente único
# afogando tudo antes mesmo de qualquer roteamento acontecer. Limites finos
# por rota (ex: /auth mais restrito que o resto) continuam em cada serviço
# de origem, sem mudança.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
